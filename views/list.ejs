<!DOCTYPE html>
<html>
<head>
    <title>To-Do List</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="container">
        <h1>To-Do List</h1>
        <ul>
            <% todos.forEach(todo => { %>
                <li><%= todo.title %></li>
            <% }); %>
        </ul>
    </div>
</body>
</html>